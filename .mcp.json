{
  "mcpServers": {
    "godot": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@coding-solo/godot-mcp@0.1.1"],
      "env": {
        "GODOT_PATH": "C:\\Program Files\\Godot\\Godot.exe",
        "DEBUG": "true"
      }
    },
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": ["blender-mcp==2.0.0"],
      "env": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
