[gd_resource type="Resource" script_class="PowerupsConfig" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/powerups_config.gd" id="1"]
[ext_resource type="Script" path="res://scripts/data/powerup_def.gd" id="2"]

[sub_resource type="Resource" id="p_shake"]
script = ExtResource("2")
id = &"shake"
display_name = "Secouer"
description = "Secoue le panier : les fruits se déplacent et fusionnent souvent."
price = 200
glyph = "≋"
color = Color(0.36, 0.68, 0.92, 1)
unlock_gift = 1
rewarded_placement = &"shake_free"

[sub_resource type="Resource" id="p_pestle"]
script = ExtResource("2")
id = &"pestle"
display_name = "Pilon"
description = "Touche un fruit pour l'écraser."
price = 250
glyph = "▼"
color = Color(0.85, 0.35, 0.25, 1)
unlock_gift = 1
rewarded_placement = &""

[sub_resource type="Resource" id="p_swap"]
script = ExtResource("2")
id = &"swap"
display_name = "Échange"
description = "Change le fruit à lâcher."
price = 200
glyph = "⇄"
color = Color(0.55, 0.8, 0.3, 1)
unlock_gift = 1
rewarded_placement = &""

[sub_resource type="Resource" id="p_grow"]
script = ExtResource("2")
id = &"grow"
display_name = "Agrandir"
description = "Le prochain fruit lâché monte d'un rang (jusqu'à la Goyave)."
price = 300
glyph = "▲"
color = Color(0.98, 0.72, 0.15, 1)
unlock_gift = 1
rewarded_placement = &""

[resource]
script = ExtResource("1")
powerups = Array[ExtResource("2")]([SubResource("p_shake"), SubResource("p_pestle"), SubResource("p_swap"), SubResource("p_grow")])
shake_cooldown = 20.0
shake_horizontal = 2.2
shake_vertical = 3.0
grow_max_rank = 5
