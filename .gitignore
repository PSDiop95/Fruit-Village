# Godot
.godot/
*.translation
*.apk
*.aab

# Captures lourdes (vidéos de démo)
*.avi
*.mp4

# Build Gradle Android (régénéré par --install-android-build-template)
android/build/*
!android/build/build.gradle
!android/build/src/
android/build/src/*
!android/build/src/main/
android/build/src/main/*
!android/build/src/main/java/

# Binaires iOS AdMob (retéléchargés automatiquement par le plugin)
addons/admob/ios/bin/

# Signature Android : JAMAIS versionnée (voir docs/KEYSTORE.md)
export_credentials.cfg
*.keystore
*.jks
*.p12
*.pem
*.der
keystore*.properties
# Clé d'upload exportée pour Play (PEPK) et bundles intermédiaires
*.zip.enc
*.apks

# Identifiants AdMob de production (modèle : ads_ids.example.cfg)
ads_ids.cfg
# Config Firebase (fournie par l'équipe, jamais versionnée)
google-services.json

# Réglages locaux
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Staging du pipeline de modèles (tools/build_models.py)
assets/models/_staging/

# Caches Python (scripts Blender)
__pycache__/

# Exports (APK/AAB)
/build/

# iOS : configuration Firebase (secret) et plugins natifs téléchargés par tools/ios/build_ios.sh
GoogleService-Info.plist
/ios/
# Clé API App Store Connect (privée) : jamais versionnée, à ranger hors du projet
*.p8
AuthKey_*
